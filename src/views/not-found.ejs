<section class="pt-16 sm:pt-24">
  <p class="text-sm font-semibold uppercase tracking-[0.08em] text-accent">404</p>
  <h1 class="mt-3 text-balance font-bold tracking-tight" style="font-size:3.5rem;line-height:1.05">
    That page isn't in the catalog.
  </h1>
  <p class="mt-4 max-w-2xl text-pretty text-base text-slate-600 dark:text-slate-400 sm:text-lg">
    The model, provider, or parameter you asked for either moved or was never tracked here.
    The catalog is community-maintained, so if something is genuinely missing you can add it.
  </p>

  <div class="mt-8 flex flex-wrap gap-3">
    <a href="/" class="border-2 border-slate-900 bg-slate-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-slate-800 dark:border-white dark:bg-white dark:text-slate-900">
      Browse all models
    </a>
    <a href="<%= glossaryPath %>" class="border-2 border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-900 hover:border-slate-400 dark:border-slate-700 dark:text-slate-100">
      Parameter glossary
    </a>
    <a href="/api" class="border-2 border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-900 hover:border-slate-400 dark:border-slate-700 dark:text-slate-100">
      API docs
    </a>
  </div>
</section>

<section class="mt-14" aria-label="Providers">
  <h2 class="text-sm font-semibold uppercase tracking-[0.08em] text-slate-500 dark:text-slate-400">
    Jump to a provider
  </h2>
  <div class="mt-4 flex flex-wrap gap-2">
    <% for (const hub of providerHubs) { %>
    <a href="<%= hub.href %>" class="inline-flex items-center gap-2 border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-700 hover:border-slate-300 hover:text-accent dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">
      <span><%= hub.label %></span>
      <span class="tabular-nums text-xs text-slate-400"><%= hub.count %></span>
    </a>
    <% } %>
  </div>
</section>
