{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modelparams-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the dynamic endpoints and the clean-URL redirects (307 → 308) run
    // the Worker. Every other file is served straight from assets, which does
    // not count against the Workers request quota; its headers come from
    // dist/_headers and the alias-host redirects are zone Redirect Rules.
    "run_worker_first": ["/mcp", "/api/mcp", "/api/v1/validate", "/*.html", "/*/"],
    // Same URLs as Vercel's cleanUrls + trailingSlash: false.
    "html_handling": "drop-trailing-slash",
    // Unknown paths get the branded dist/404.html with a 404 status.
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": true },
}
