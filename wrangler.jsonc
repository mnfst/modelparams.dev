{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modelparams-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker runs first: it redirects the alias hosts, answers /mcp and
    // /api/v1/validate, and adds the headers vercel.json used to set.
    "run_worker_first": true,
    // Same URLs as Vercel's cleanUrls + trailingSlash: false.
    "html_handling": "drop-trailing-slash",
    // Unknown paths get the branded dist/404.html with a 404 status.
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": true },
}
